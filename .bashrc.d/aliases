# The basics
alias c="clear"
alias l="ls -ahl"
alias t="tree -a -A -L 3"

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Common programs
alias tx="tmux"

if command -v lazygit &>/dev/null; then
  alias lg="lazygit"
fi

if command -v nvim &>/dev/null; then
  alias v="nvim"
  alias vi="nvim"
  alias vim="nvim"
fi

# Git (general)
alias ga="git add"
alias gc="git commit"
alias gd="git diff"
alias gl="git log -10"
alias gs="git status -sb | sort -bf"

# Git (branches)
alias gbc="git checkout -b"     # create
alias gbd="git branch -d"       # delete
alias gbr="git branch -m"       # rename
alias gbs="git checkout"        # switch

# Podman > Docker
alias docker="podman"
